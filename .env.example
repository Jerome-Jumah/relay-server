# DNS A records must point directly to PUBLIC_IP (no CDN proxy).
SIP_DOMAIN=sip.example.com
# Absolute VPS directory containing wss.pem (full certificate chain + private key).
# Must be readable by container UID 10001; mounted read-only, never baked into images.
WSS_CERT_DIR=/opt/relay/certs/wss
PUBLIC_IP=203.0.113.10
TURN_REALM=turn.example.com

# Inclusive extension range; maximum 10,000 users. No leading zeroes.
SIP_EXT_START=1001
SIP_EXT_END=1099
# Generate each separately: openssl rand -hex 32
# Keep the seed stable: changing it changes every SIP password.
SIP_PASSWORD_SEED=
ESL_PASSWORD=
TURN_USERNAME=relay
TURN_PASSWORD=

# Keep ranges disjoint. Host mappings preserve the same port numbers.
RTP_START=16384
RTP_END=16483
TURN_PORT=3478
TURN_MIN_PORT=49160
TURN_MAX_PORT=49259
